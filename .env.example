DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# 레거시 프로젝트 호환용. SUPABASE_SECRET_KEY가 있으면 사용하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=""
# 서버 전용 Supabase secret key(sb_secret_...). NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_SECRET_KEY=""
MANAGEMENT_ACCESS_CODE=""
MANAGEMENT_SESSION_SECRET=""
MANAGEMENT_ADMIN_NAME="관리자"
MANAGEMENT_ADMIN_LEVEL="1"

NEXT_PUBLIC_BASE_URL="https://www.aqaralife-service.kr"

# SMS (Solapi). 셋 모두 비어있으면 SMS 는 silent skip.
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_SENDER=""

# 다른 프로젝트가 /api/internal/sms 를 호출할 때 사용하는 x-internal-key 헤더 값.
INTERNAL_API_KEY=""

# ERP (더존 NEOE)
ERP_SERVER=
ERP_PORT=
ERP_USER=
ERP_PASSWORD=
ERP_PARTNER_CODE=

# PII = 개인정보
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

CRON_SECRET=

# Cafe24 쇼핑몰 연동 (OAuth 토큰 발급/갱신 + 결제 완료 시 기기 기능 활성화 webhook)
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=
CAFE24_MALL_ID="aqarakr"
# Cafe24 webhook 수신 URL 에 붙이는 공유 secret.
# 예) Cafe24 관리자에서 수신 URL 을 https://www.aqaralife-service.kr/api/cafe24/webhook?key=<이 값> 으로 설정.
# 비어있으면 webhook 검증을 건너뛴다(권장하지 않음).
CAFE24_WEBHOOK_SECRET=
