generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model ShippedDevice {
  id          String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  sn          String  @unique
  model       String?
  shippedDate String? @map("shipped_date")
  batchId     String? @map("batch_id")

  @@map("shipped_devices")
}

model WarrantyRegistration {
  id                    String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  sn                    String              @unique
  installType           String              @default("installer") @map("install_type")
  installDate           String              @map("install_date")
  userPhone             String              @map("user_phone")
  installerPhone        String?             @map("installer_phone")
  consentPrivacy        Boolean             @map("consent_privacy")
  status                String              @default("submitted")
  confirmToken          String?             @unique @map("confirm_token")
  confirmTokenExpiresAt DateTime?           @map("confirm_token_expires_at") @db.Timestamptz(6)
  freeAsEndDate         String?             @map("free_as_end_date")
  submittedAt           DateTime            @default(now()) @map("submitted_at") @db.Timestamptz(6)
  confirmedAt           DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy           String?             @map("confirmed_by")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  consentMarketing      Boolean             @default(false) @map("consent_marketing")
  surveySentAt          DateTime?           @map("survey_sent_at")
  survey                SatisfactionSurvey?

  @@index([status])
  @@index([installerPhone], map: "idx_reg_installer_phone")
  @@index([sn], map: "idx_reg_sn")
  @@index([status], map: "idx_reg_status")
  @@index([submittedAt], map: "idx_reg_submitted_at")
  @@map("warranty_registrations")
}

model Installer {
  id                   String                                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                 String
  phone                String                                    @unique
  branch               String?
  region               String?
  coverage             String?
  address              String?
  category             String?
  ability              String?
  installCount         Int?                                      @map("install_count")
  happyCallLt          Int?                                      @map("happy_call_lt")
  defectCount          Int?                                      @map("defect_count")
  dissatisfactionNote  String?                                   @map("dissatisfaction_note")
  createdAt            DateTime                                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  serviceAreas         String[]                                  @default([]) @map("service_areas")
  capabilities         String[]                                  @default([]) @map("capabilities")
  aqaraAppCapability   String                                    @default("NONE") @map("aqara_app_capability")
  hasAqaraHubInventory Boolean                                   @default(false) @map("has_aqara_hub_inventory")
  monthlyDispatchCount Int                                       @default(0) @map("monthly_dispatch_count")
  active               Boolean                                   @default(true) @map("active")
  currentOrders        InstallationOrder[]                       @relation("CurrentInstaller")
  assignmentAttempts   InstallationInstallerAssignmentAttempt[]  @relation("InstallerAssignmentAttempts")
  candidateRunResults  InstallationInstallerCandidateRunResult[]
  devices              InstallerDevice[]                         @relation("InstallerDevices")
  asOrders             AsOrder[]                                 @relation("AsCurrentInstaller")
  rateOverride         InstallerRate?                            @relation("InstallerRateOverride")
  settlementLines      SettlementLine[]                          @relation("InstallerSettlementLines")

  @@index([branch])
  @@index([region])
  @@index([active])
  @@index([capabilities], map: "installers_capabilities_gin_idx", type: Gin)
  @@index([serviceAreas], map: "installers_service_areas_gin_idx", type: Gin)
  @@map("installers")
}

// P1 installer app: DB-backed, rate-limited OTP (replaces the in-memory
// api/auth/sms). Stores only a hash of the phone and of the code.
model InstallerAuthOtp {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  phoneHash  String    @map("phone_hash")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneHash, createdAt])
  @@map("installer_auth_otps")
}

// P1 installer app: FCM device tokens per installer (productionizes the
// throwaway push_test_fcm_token table).
model InstallerDevice {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  installerId String    @map("installer_id")
  installer   Installer @relation("InstallerDevices", fields: [installerId], references: [id], onDelete: Cascade)
  fcmToken    String    @unique @map("fcm_token")
  platform    String    @default("android")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @updatedAt @map("last_seen_at") @db.Timestamptz(6)

  @@index([installerId])
  @@map("installer_devices")
}

model Admin {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  loginCode String   @unique @map("login_code")
  name      String
  level     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([level])
  @@map("admins")
}

model SmsTemplate {
  key       String   @id
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("sms_templates")
}

model SatisfactionSurvey {
  id             String               @id @default(uuid())
  registrationId String               @unique @map("registration_id")
  q1_1           String
  q1_2           String
  q1_3           String
  q2_1           String
  q2_2           String
  q2_3           String
  q3_1           Int
  comment        String?
  createdAt      DateTime             @default(now()) @map("created_at")
  registration   WarrantyRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("satisfaction_surveys")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model app_settings {
  settings_key   String @id
  settings_value String
}

model cafe24_tokens {
  id                       String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  mall_id                  String   @unique
  access_token             String
  refresh_token            String
  expires_at               DateTime @db.Timestamptz(6)
  refresh_token_expires_at DateTime @db.Timestamptz(6)
  client_id                String?
  scope                    String?
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model device_feature_upgrades {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sn                String    @unique
  contact           String?
  purchase_status   String    @default("pending")
  feature_code      String    @default("zigbee")
  payment_provider  String    @default("demo")
  paid_at           DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
  last_hub_bound_at DateTime? @db.Timestamptz(6)

  @@index([purchase_status], map: "idx_device_feature_upgrades_purchase_status")
}

model lumi_product_sn {
  id      BigInt   @id @default(autoincrement())
  lumi_sn String   @unique
  time    DateTime @db.Timestamptz(6)

  @@index([lumi_sn], map: "idx_lumi_product_sn_lumi_sn")
  @@index([time], map: "idx_lumi_product_sn_time")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model production_lumiSN {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model production_records {
  id              BigInt          @id @default(autoincrement())
  lumi_sn         String
  solity_sn       String
  production_time String
  operator_name   String?         @default("")
  note            String?         @default("")
  used_sn_codes   used_sn_codes[]

  @@unique([lumi_sn, solity_sn])
  @@index([lumi_sn], map: "idx_production_records_lumi_sn")
  @@index([solity_sn], map: "idx_production_records_solity_sn")
  @@index([production_time(sort: Desc)], map: "idx_production_records_time")
}

model survey_responses {
  id                       Int                  @id @default(autoincrement())
  attendance_status        attendance_status
  business_name            String               @db.VarChar(200)
  contact_name             String               @db.VarChar(100)
  contact_phone            String               @db.VarChar(30)
  email                    String?              @db.VarChar(320)
  sales_experience         sales_experience
  annual_sales_volume      annual_sales_volume
  sales_target             sales_target
  installation_method      installation_method
  installation_staff       installation_staff
  iot_expansion_intent     iot_expansion_intent
  attendance_purpose       String
  attendance_purpose_other String?
  interested_products      String?
  additional_inquiry       String?
  submitted_at             DateTime             @default(now()) @db.Timestamp(6)
  ip_address               String?              @db.VarChar(45)
  contact_position         String?              @db.VarChar(100)
  business_zipcode         String?              @db.VarChar(10)
  business_address         String?              @db.VarChar(300)
  business_address_detail  String?              @db.VarChar(200)

  @@index([submitted_at], map: "idx_survey_responses_submitted_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model used_sn_codes {
  sn_value           String             @id
  record_id          BigInt
  sn_role            String
  production_records production_records @relation(fields: [record_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id             Int      @id @default(autoincrement())
  open_id        String   @unique @db.VarChar(64)
  name           String?
  email          String?  @db.VarChar(320)
  login_method   String?  @db.VarChar(64)
  role           role     @default(user)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @default(now()) @db.Timestamp(6)
  last_signed_in DateTime @default(now()) @db.Timestamp(6)

  @@index([open_id], map: "idx_users_open_id")
}

enum annual_sales_volume {
  under100
  to300    @map("100to300")
  to500    @map("300to500")
  to1000   @map("500to1000")
  over1000
}

enum attendance_status {
  attend
  not_attend
  reviewing
}

enum installation_method {
  own_team
  outsource
  mixed
}

enum installation_staff {
  none
  to2    @map("1to2")
  to5    @map("3to5")
  to10   @map("6to10")
  over10
}

enum iot_expansion_intent {
  already
  reviewing
  interested
  none
}

enum reg_status {
  submitted
  confirmed
  void
}

enum role {
  user
  admin
}

enum sales_experience {
  under1
  to3    @map("1to3")
  to5    @map("3to5")
  to10   @map("5to10")
  over10
}

enum sales_target {
  enduser
  b2b
  both
}

enum InstallationOrderStatus {
  CUSTOMER_INPUT_SMS_REQUIRED
  WAITING_CUSTOMER_INPUT
  READY_FOR_CANDIDATE_SELECTION
  WAITING_ADMIN_REVIEW
  WAITING_INSTALLER_RESPONSE
  INSTALLER_ASSIGNED
  WAITING_HQ_REVIEW
  CANCELLED
  COMPLETED
}

enum InstallationCustomerRequestStatus {
  PENDING_INPUT
  SUBMITTED
  FALLBACK_USED
  CANCELLED
}

enum InstallationInstallerAssignmentStatus {
  WAITING_ADMIN_REVIEW
  WAITING_INSTALLER_RESPONSE
  INSTALLER_ACCEPTED
  INSTALLER_REJECTED
  INSTALLER_RESPONSE_TIMED_OUT
  ADMIN_MANUAL_OVERRIDDEN
  ADMIN_COMPLETED
  SYSTEM_SMS_RETRY_PENDING
  SYSTEM_SMS_FAILED
}

enum InstallationNotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  UNKNOWN
}

enum InstallationIssueType {
  ORDER_CUSTOMER_PHONE_MISSING
  ORDER_CUSTOMER_PHONE_INVALID
  ORDER_PRODUCT_REQUIREMENT_UNMAPPED
  CUSTOMER_INPUT_NOT_SUBMITTED
  CUSTOMER_INPUT_ADDRESS_UNPARSABLE
  CUSTOMER_INPUT_LINK_SMS_SEND_FAILED
  INSTALLER_CANDIDATE_NOT_FOUND
  INSTALLER_CANDIDATE_EXHAUSTED
  INSTALLER_NOT_ASSIGNED
  INSTALLATION_NOT_COMPLETED
  INSTALLATION_AUTOMATION_FAILED
  INSTALLATION_WORKFLOW_ORPHANED
  INSTALLER_ASSIGNMENT_SMS_SEND_FAILED
  CUSTOMER_ASSIGNMENT_SMS_SEND_FAILED
}

enum InstallationIssueStatus {
  OPEN
  RESOLVED
}

model CronJobRunLock {
  key         String   @id
  lockedUntil DateTime @map("locked_until")
  lockedBy    String?  @map("locked_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cron_job_run_locks")
}

model CronJobStatus {
  key            String    @id
  path           String
  schedule       String?
  lastCalledAt   DateTime? @map("last_called_at")
  lastStartedAt  DateTime? @map("last_started_at")
  lastFinishedAt DateTime? @map("last_finished_at")
  lastStatus     String?   @map("last_status")
  lastDurationMs Int?      @map("last_duration_ms")
  lastErrorCode  String?   @map("last_error_code")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("cron_job_statuses")
}

model BackofficeSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("backoffice_settings")
}

model BackofficeUser {
  id             String   @id @default(uuid())
  supabaseUserId String?  @unique @map("supabase_user_id")
  emailEncrypted String   @unique @map("email_encrypted")
  emailHash      String?  @unique @map("email_hash")
  level          Int      @default(0)
  lastLoginAt    DateTime @default(now()) @map("last_login_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([level])
  @@map("backoffice_users")
}

model InstallationOrder {
  id                      String                                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sourceId                String?                                  @unique @map("source_id")
  source                  InstallationOrderSource?                 @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  status                  InstallationOrderStatus                  @default(CUSTOMER_INPUT_SMS_REQUIRED)
  activeCustomerRequestId String?                                  @map("active_customer_request_id")
  activeCustomerRequest   InstallationCustomerRequest?             @relation("ActiveCustomerRequest", fields: [activeCustomerRequestId], references: [id], onDelete: SetNull)
  activeAssignmentId      String?                                  @map("active_assignment_id")
  activeAssignment        InstallationInstallerAssignmentAttempt?  @relation("ActiveAssignment", fields: [activeAssignmentId], references: [id], onDelete: SetNull)
  currentInstallerId      String?                                  @map("current_installer_id")
  currentInstaller        Installer?                               @relation("CurrentInstaller", fields: [currentInstallerId], references: [id], onDelete: SetNull)
  hasOpenIssue            Boolean                                  @default(false) @map("has_open_issue")
  lastIssueId             String?                                  @map("last_issue_id")
  lastIssue               InstallationIssue?                       @relation("LastIssue", fields: [lastIssueId], references: [id], onDelete: SetNull)
  cancelledAt             DateTime?                                @map("cancelled_at")
  cancelReason            String?                                  @map("cancel_reason")
  statusChangedAt         DateTime                                 @default(now()) @map("status_changed_at")
  createdAt               DateTime                                 @default(now()) @map("created_at")
  updatedAt               DateTime                                 @updatedAt @map("updated_at")
  customerRequests        InstallationCustomerRequest[]            @relation("InstallationOrderCustomerRequests")
  assignmentAttempts      InstallationInstallerAssignmentAttempt[] @relation("InstallationOrderAssignmentAttempts")
  candidateRuns           InstallationInstallerCandidateRun[]
  statusEvents            InstallationOrderStatusEvent[]
  issues                  InstallationIssue[]                      @relation("InstallationOrderIssues")
  notifications           InstallationNotification[]
  completion              InstallationCompletion?

  @@index([status, createdAt])
  @@index([status, statusChangedAt])
  @@map("installation_orders")
}

// P2: installer completion registration (photos, install-end time, achieved
// linkage level) + HQ review/rejection. One row per order, upserted on resubmit.
model InstallationCompletion {
  id                         String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  installationOrderId        String            @unique @map("installation_order_id")
  installationOrder          InstallationOrder @relation(fields: [installationOrderId], references: [id], onDelete: Cascade)
  submittedInstallerId       String            @map("submitted_installer_id")
  submittedAt                DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  achievedAqaraAppCapability String            @default("NONE") @map("achieved_aqara_app_capability")
  wallpadLinked              Boolean           @default(false) @map("wallpad_linked")
  wallpadAmount              Int?              @map("wallpad_amount")
  longDistanceAmount         Int?              @map("long_distance_amount")
  installEndAt               DateTime          @map("install_end_at") @db.Timestamptz(6)
  photoPaths                 String[]          @default([]) @map("photo_paths")
  reviewStatus               String            @default("PENDING") @map("review_status")
  reviewedByAdminId          String?           @map("reviewed_by_admin_id")
  reviewedAt                 DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason            String?           @map("rejection_reason")
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([reviewStatus])
  @@map("installation_completions")
}

model InstallationOrderSource {
  id                    String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  sourceKey             String             @unique @map("source_key")
  customerNameEncrypted String?            @map("customer_name_encrypted")
  customerNameHash      String?            @map("customer_name_hash")
  phoneEncrypted        String?            @map("phone_encrypted")
  phoneHash             String?            @map("phone_hash")
  addressEncrypted      String?            @map("address_encrypted")
  dueDate               String?            @map("due_date")
  orderNumbers          String?            @map("order_numbers")
  noGirl                String?            @map("no_girl")
  memo                  String?            @db.Text
  // CJ(외부 채널) 유입 구분. SELF = 자사 ERP 동기화 건.
  channel               String             @default("SELF")
  // 외부 채널 주문번호(CJ). 채널 내에서만 유일하므로 sourceKey 로도 쓴다.
  externalOrderNo       String?            @map("external_order_no")
  externalOrderDate     String?            @map("external_order_date")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  order                 InstallationOrder?

  @@index([dueDate])
  @@index([channel])
  @@map("installation_order_sources")
}

model InstallationCustomerRequest {
  id                            String                                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  installationOrderId           String                                   @map("installation_order_id")
  installationOrder             InstallationOrder                        @relation("InstallationOrderCustomerRequests", fields: [installationOrderId], references: [id], onDelete: Cascade)
  requestNumber                 Int                                      @map("request_number")
  customerNameEncrypted         String?                                  @map("customer_name_encrypted")
  customerNameHash              String?                                  @map("customer_name_hash")
  customerPhoneEncrypted        String?                                  @map("customer_phone_encrypted")
  customerPhoneHash             String?                                  @map("customer_phone_hash")
  customerPhoneSource           String                                   @default("PENDING_CUSTOMER") @map("customer_phone_source")
  // 주문자 번호(CJ 채널). SMS 인증을 통과한 번호라 예비 연락처로 신뢰할 수 있다.
  // customerPhone* 은 계속 "설치 받는 분" = 기사가 실제로 거는 번호를 뜻한다.
  ordererPhoneEncrypted         String?                                  @map("orderer_phone_encrypted")
  ordererPhoneHash              String?                                  @map("orderer_phone_hash")
  ordererPhoneVerifiedAt        DateTime?                                @map("orderer_phone_verified_at") @db.Timestamptz(6)
  installAddressEncrypted       String?                                  @map("install_address_encrypted")
  installAddressDetailEncrypted String?                                  @map("install_address_detail_encrypted")
  installAddress1Encrypted      String?                                  @map("install_address1_encrypted")
  installAddress2Encrypted      String?                                  @map("install_address2_encrypted")
  installDate                   String?                                  @map("install_date")
  installTimeSlot               String?                                  @map("install_time_slot")
  customerNote                  String?                                  @map("customer_note")
  customerTokenHash             String                                   @unique @map("customer_token_hash")
  customerTokenExpiresAt        DateTime                                 @map("customer_token_expires_at")
  customerSubmittedAt           DateTime?                                @map("customer_submitted_at")
  fallbackUsed                  Boolean                                  @default(false) @map("fallback_used")
  status                        InstallationCustomerRequestStatus        @default(PENDING_INPUT)
  createdAt                     DateTime                                 @default(now()) @map("created_at")
  updatedAt                     DateTime                                 @updatedAt @map("updated_at")
  activeForOrders               InstallationOrder[]                      @relation("ActiveCustomerRequest")
  assignmentAttempts            InstallationInstallerAssignmentAttempt[]
  notifications                 InstallationNotification[]
  candidateRuns                 InstallationInstallerCandidateRun[]

  @@unique([installationOrderId, requestNumber])
  @@unique([id, installationOrderId])
  @@index([status])
  @@index([ordererPhoneHash])
  @@map("installation_customer_requests")
}

model InstallationInstallerAssignmentAttempt {
  id                      String                                @id @default(dbgenerated("(gen_random_uuid())::text"))
  installationOrderId     String                                @map("installation_order_id")
  installationOrder       InstallationOrder                     @relation("InstallationOrderAssignmentAttempts", fields: [installationOrderId], references: [id], onDelete: Cascade)
  customerRequestId       String?                               @map("customer_request_id")
  customerRequest         InstallationCustomerRequest?          @relation(fields: [customerRequestId], references: [id], onDelete: SetNull)
  installerId             String                                @map("installer_id")
  installer               Installer                             @relation("InstallerAssignmentAttempts", fields: [installerId], references: [id], onDelete: Restrict)
  assignmentNumber        Int                                   @map("assignment_number")
  assignmentSource        String                                @default("AUTO") @map("assignment_source")
  matchTier               String?                               @map("match_tier")
  candidateRank           Int?                                  @map("candidate_rank")
  selectionSnapshot       Json?                                 @map("selection_snapshot")
  installerTokenHash      String?                               @unique @map("installer_token_hash")
  installerTokenExpiresAt DateTime?                             @map("installer_token_expires_at")
  status                  InstallationInstallerAssignmentStatus @default(WAITING_INSTALLER_RESPONSE)
  installerNotifiedAt     DateTime?                             @map("installer_notified_at")
  acceptedAt              DateTime?                             @map("accepted_at")
  rejectedAt              DateTime?                             @map("rejected_at")
  rejectReason            String?                               @map("reject_reason")
  timedOutAt              DateTime?                             @map("timed_out_at")
  createdByAdminId        String?                               @map("created_by_admin_id")
  approvedByAdminId       String?                               @map("approved_by_admin_id")
  cancelledByAdminId      String?                               @map("cancelled_by_admin_id")
  createdAt               DateTime                              @default(now()) @map("created_at")
  updatedAt               DateTime                              @updatedAt @map("updated_at")
  activeForOrders         InstallationOrder[]                   @relation("ActiveAssignment")
  notifications           InstallationNotification[]

  @@unique([installationOrderId, assignmentNumber])
  @@unique([id, installationOrderId])
  @@index([status, createdAt])
  @@index([installerId, createdAt])
  @@map("installation_installer_assignment_attempts")
}

model InstallationInstallerCandidateRun {
  id                  String                                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  installationOrderId String                                    @map("installation_order_id")
  installationOrder   InstallationOrder                         @relation(fields: [installationOrderId], references: [id], onDelete: Cascade)
  customerRequestId   String?                                   @map("customer_request_id")
  customerRequest     InstallationCustomerRequest?              @relation(fields: [customerRequestId], references: [id], onDelete: SetNull)
  assignmentSource    String                                    @default("AUTO") @map("assignment_source")
  reasonCode          String?                                   @map("reason_code")
  inputSnapshot       Json?                                     @map("input_snapshot")
  createdAt           DateTime                                  @default(now()) @map("created_at")
  candidates          InstallationInstallerCandidateRunResult[]

  @@index([installationOrderId, createdAt])
  @@map("installation_installer_candidate_runs")
}

model InstallationInstallerCandidateRunResult {
  id                     String                            @id @default(dbgenerated("(gen_random_uuid())::text"))
  candidateRunId         String                            @map("candidate_run_id")
  candidateRun           InstallationInstallerCandidateRun @relation(fields: [candidateRunId], references: [id], onDelete: Cascade)
  installerId            String                            @map("installer_id")
  installer              Installer                         @relation(fields: [installerId], references: [id], onDelete: Restrict)
  rank                   Int?
  isAutoRequestCandidate Boolean                           @default(false) @map("is_auto_request_candidate")
  regionTier             String?                           @map("region_tier")
  monthlyDispatchCount   Int                               @default(0) @map("monthly_dispatch_count")
  lastRequestedAt        DateTime?                         @map("last_requested_at")
  excludedReason         String?                           @map("excluded_reason")
  decisionReason         String                            @map("decision_reason")
  createdAt              DateTime                          @default(now()) @map("created_at")

  @@index([candidateRunId, rank])
  @@index([installerId])
  @@map("installation_installer_candidate_run_results")
}

model InstallationNotification {
  id                      String                                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  installationOrderId     String                                  @map("installation_order_id")
  installationOrder       InstallationOrder                       @relation(fields: [installationOrderId], references: [id], onDelete: Cascade)
  customerRequestId       String?                                 @map("customer_request_id")
  customerRequest         InstallationCustomerRequest?            @relation(fields: [customerRequestId], references: [id], onDelete: SetNull)
  assignmentAttemptId     String?                                 @map("installation_assignment_id")
  assignmentAttempt       InstallationInstallerAssignmentAttempt? @relation(fields: [assignmentAttemptId], references: [id], onDelete: SetNull)
  smsType                 String                                  @map("sms_type")
  recipientType           String                                  @map("recipient_type")
  recipientPhoneEncrypted String?                                 @map("recipient_phone_encrypted")
  recipientPhoneHash      String?                                 @map("recipient_phone_hash")
  smsTemplateKey          String?                                 @map("sms_template_key")
  smsBody                 String                                  @map("sms_body")
  // 알림톡 발송에 필요한 템플릿/변수. 본문(sms_body)은 대체발송용으로 남는다.
  // 값이 없으면 SMS 로만 발송한다.
  alimtalkTemplateKey     String?                                 @map("alimtalk_template_key")
  alimtalkVariables       Json?                                   @map("alimtalk_variables")
  provider                String                                  @default("solapi")
  providerMessageId       String?                                 @map("provider_message_id")
  providerStatus          String?                                 @map("provider_status")
  providerStatusCode      String?                                 @map("provider_status_code")
  providerReason          String?                                 @map("provider_reason")
  providerReportedAt      DateTime?                               @map("provider_reported_at")
  providerCheckedAt       DateTime?                               @map("provider_checked_at")
  status                  InstallationNotificationStatus          @default(PENDING)
  errorCode               String?                                 @map("error_code")
  errorMessage            String?                                 @map("error_message")
  idempotencyKey          String                                  @unique @map("idempotency_key")
  retryCount              Int                                     @default(0) @map("retry_count")
  deliveryCheckCount      Int                                     @default(0) @map("delivery_check_count")
  sentAt                  DateTime?                               @map("sent_at")
  // 앱 푸시를 먼저 보낸 시각. 이 시각 기준으로 폴백 문자 발송 여부를 판단한다.
  pushSentAt              DateTime?                               @map("push_sent_at")
  createdAt               DateTime                                @default(now()) @map("created_at")
  updatedAt               DateTime                                @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([status, providerCheckedAt])
  @@map("installation_notifications")
}

model InstallationOrderStatusEvent {
  id                  String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  installationOrderId String                   @map("installation_order_id")
  installationOrder   InstallationOrder        @relation(fields: [installationOrderId], references: [id], onDelete: Cascade)
  fromStatus          InstallationOrderStatus? @map("from_status")
  toStatus            InstallationOrderStatus  @map("to_status")
  eventType           String                   @map("event_type")
  actorType           String                   @map("actor_type")
  actorId             String?                  @map("actor_id")
  reason              String?
  metadata            Json?
  createdAt           DateTime                 @default(now()) @map("created_at")

  @@index([installationOrderId, createdAt])
  @@index([eventType, createdAt])
  @@map("installation_order_status_events")
}

// P3: A/S (after-sales repair). Admin-created; dispatched to an installer
// (prefer the original installer, else by address). Reject routes back to
// admin (no auto-reassign). Completion (처리 details + 용역비 + optional photos)
// is HQ-reviewed. Completion fields are inline (1:1 with the order).
enum AsOrderStatus {
  WAITING_ASSIGNMENT
  WAITING_INSTALLER_RESPONSE
  INSTALLER_ASSIGNED
  WAITING_HQ_REVIEW
  COMPLETED
  CANCELLED
}

model AsOrder {
  id                          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  status                      AsOrderStatus        @default(WAITING_ASSIGNMENT)
  // customer (PII: encrypted for display, hashed for search)
  customerNameEncrypted       String?              @map("customer_name_encrypted")
  customerNameHash            String?              @map("customer_name_hash")
  customerPhoneEncrypted      String?              @map("customer_phone_encrypted")
  customerPhoneHash           String?              @map("customer_phone_hash")
  addressEncrypted            String?              @map("address_encrypted")
  // symptom
  symptomCode                 String               @map("symptom_code")
  symptomDetail               String?              @map("symptom_detail")
  // reference to the original install (plain refs; no FK coupling)
  orderNo                     String?              @map("order_no")
  originalInstallationOrderId String?              @map("original_installation_order_id")
  memo                        String?
  // assignment
  currentInstallerId          String?              @map("current_installer_id")
  currentInstaller            Installer?           @relation("AsCurrentInstaller", fields: [currentInstallerId], references: [id], onDelete: SetNull)
  assignedAt                  DateTime?            @map("assigned_at") @db.Timestamptz(6)
  respondedAt                 DateTime?            @map("responded_at") @db.Timestamptz(6)
  installerSmsRemindedAt      DateTime?            @map("installer_sms_reminded_at") @db.Timestamptz(6)
  installerRejectReason       String?              @map("installer_reject_reason")
  // completion (inline)
  resolutionDetail            String?              @map("resolution_detail")
  serviceFee                  Int?                 @map("service_fee")
  completionPhotoPaths        String[]             @default([]) @map("completion_photo_paths")
  submittedAt                 DateTime?            @map("submitted_at") @db.Timestamptz(6)
  reviewStatus                String?              @map("review_status")
  reviewedByAdminId           String?              @map("reviewed_by_admin_id")
  reviewedAt                  DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  hqRejectionReason           String?              @map("hq_rejection_reason")
  // meta
  createdByAdminId            String?              @map("created_by_admin_id")
  statusChangedAt             DateTime             @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  statusEvents                AsOrderStatusEvent[]

  @@index([status, createdAt])
  @@index([currentInstallerId])
  @@index([customerPhoneHash])
  @@map("as_orders")
}

model AsOrderStatusEvent {
  id         String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  asOrderId  String         @map("as_order_id")
  asOrder    AsOrder        @relation(fields: [asOrderId], references: [id], onDelete: Cascade)
  fromStatus AsOrderStatus? @map("from_status")
  toStatus   AsOrderStatus  @map("to_status")
  eventType  String         @map("event_type")
  actorType  String         @map("actor_type")
  actorId    String?        @map("actor_id")
  reason     String?
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([asOrderId, createdAt])
  @@map("as_order_status_events")
}

model InstallationIssue {
  id                  String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  installationOrderId String                  @map("installation_order_id")
  installationOrder   InstallationOrder       @relation("InstallationOrderIssues", fields: [installationOrderId], references: [id], onDelete: Cascade)
  type                InstallationIssueType
  title               String
  description         String?
  metadata            Json?
  status              InstallationIssueStatus @default(OPEN)
  resolvedByAdminId   String?                 @map("resolved_by_admin_id")
  resolvedAt          DateTime?               @map("resolved_at")
  resolutionNote      String?                 @map("resolution_note")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  lastForOrders       InstallationOrder[]     @relation("LastIssue")

  @@unique([id, installationOrderId])
  @@index([status, createdAt])
  @@map("installation_issues")
}

// ── P4 정산 (settlement) ────────────────────────────────────────────────
// Per-installer rate overrides. Null column = fall back to global default
// (system_settings installation.settlement.*). Amounts in KRW (won), integer.
model InstallerRate {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  installerId      String    @unique @map("installer_id")
  installer        Installer @relation("InstallerRateOverride", fields: [installerId], references: [id], onDelete: Cascade)
  linkageAppFee    Int?      @map("linkage_app_fee")
  linkageHubFee    Int?      @map("linkage_hub_fee")
  travelFee        Int?      @map("travel_fee")
  nightSurcharge   Int?      @map("night_surcharge")
  weekendSurcharge Int?      @map("weekend_surcharge")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("installer_rates")
}

// A custom settlement period. status: OPEN (待결산) | SETTLED (已결산).
model SettlementPeriod {
  id               String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  name             String
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime         @map("end_date") @db.Date
  status           String           @default("OPEN")
  settledAt        DateTime?        @map("settled_at") @db.Timestamptz(6)
  settledByAdminId String?          @map("settled_by_admin_id")
  createdByAdminId String?          @map("created_by_admin_id")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lines            SettlementLine[]

  @@index([status])
  @@map("settlement_periods")
}

// One frozen snapshot per approved completion (install) or A/S order.
// Written inside the approve transaction (§8.5 M1). Read-only afterwards.
// sourceType: INSTALL | AS. sourceOrderId = InstallationOrder.id | AsOrder.id.
model SettlementLine {
  id                String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  installerId       String            @map("installer_id")
  installer         Installer         @relation("InstallerSettlementLines", fields: [installerId], references: [id])
  sourceType        String            @map("source_type")
  sourceOrderId     String            @map("source_order_id")
  completedAt       DateTime          @map("completed_at") @db.Timestamptz(6)
  approvedByAdminId String?           @map("approved_by_admin_id")
  // frozen line items (KRW). Absent items = 0.
  linkageFee        Int               @default(0) @map("linkage_fee")
  travelFee         Int               @default(0) @map("travel_fee")
  longDistanceFee   Int               @default(0) @map("long_distance_fee")
  nightWeekendFee   Int               @default(0) @map("night_weekend_fee")
  serviceFee        Int               @default(0) @map("service_fee")
  wallpadAmount     Int               @default(0) @map("wallpad_amount")
  totalAmount       Int               @default(0) @map("total_amount")
  rateSource        Json?             @map("rate_source")
  breakdown         Json?
  periodId          String?           @map("period_id")
  period            SettlementPeriod? @relation(fields: [periodId], references: [id])
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceType, sourceOrderId])
  @@index([installerId])
  @@index([periodId])
  @@index([completedAt])
  @@map("settlement_lines")
}

// ─── CJ 채널 (외부 판매 채널 고객 입력) ──────────────────────────────────────
// CJ 온스타일로 판매된 건은 배송을 CJ 가 맡아 고객 정보가 우리에게 오지 않는다.
// 그래서 자사 채널과 달리 "주문 → 링크 발송" 이 아니라 "고객이 공개 링크에서
// 제출 → 그 때 주문 생성" 순서로 흐른다. 폴백(배송지 정보로 자동 배정)은 쓸
// 자료 자체가 없으므로 없다. 미제출 건은 CJ 책임.

// CJ 가 직접 업로드하는 주문번호 명단. 고객이 입력한 주문번호가 여기에 있어야
// 제출할 수 있고, 한 주문번호는 한 번만 쓸 수 있다.
model CjOrderManifest {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderNo             String    @unique @map("order_no")
  orderDate           String?   @map("order_date")
  uploadBatchId       String?   @map("upload_batch_id")
  // 제출에 쓰인 순간 채워진다. 두 번째 제출을 막는 기준.
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(6)
  installationOrderId String?   @map("installation_order_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([consumedAt])
  @@index([uploadBatchId])
  @@map("cj_order_manifests")
}

// 업로드 이력. CJ 담당자가 자기가 언제 무엇을 올렸는지 확인하는 용도.
model CjManifestUpload {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  fileName       String   @map("file_name")
  totalRows      Int      @default(0) @map("total_rows")
  insertedCount  Int      @default(0) @map("inserted_count")
  duplicateCount Int      @default(0) @map("duplicate_count")
  invalidCount   Int      @default(0) @map("invalid_count")
  uploadedBy     String?  @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("cj_manifest_uploads")
}

// 고객용 OTP. installer_auth_otps 와 같은 구조(해시만 저장, 레이트 리밋).
// 인증에 성공하면 지우지 않고 verifiedToken 을 남겨, 제출 시 서버가 "이 번호는
// 인증을 통과했다" 를 검증할 수 있게 한다. 공개 페이지라 이 검증이 없으면
// 프런트를 건너뛴 직접 POST 로 인증을 우회할 수 있다.
model CustomerAuthOtp {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  phoneHash     String    @map("phone_hash")
  codeHash      String    @map("code_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedToken String?   @unique @map("verified_token")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneHash, createdAt])
  @@map("customer_auth_otps")
}

// CJ 담당자 계정. 백오피스(admins) 와 완전히 분리해 둔다. 같은 테이블에 두면
// 백오피스 페이지 한 곳만 레벨 검사를 빠뜨려도 고객 개인정보가 새기 때문이다.
// 이 계정으로 접근할 수 있는 것은 /partner 아래 업로드 화면뿐이다.
model PartnerAccount {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  loginId      String    @unique @map("login_id")
  passwordHash String    @map("password_hash")
  name         String
  partnerCode  String    @default("CJ") @map("partner_code")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("partner_accounts")
}
