generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model ShippedDevice {
  id          String    @id @default(uuid())
  sn          String    @unique
  model       String?
  shippedDate String?  @map("shipped_date")
  batchId     String?   @map("batch_id")

  @@map("shipped_devices")
}

model WarrantyRegistration {
  id                    String    @id @default(uuid())
  sn                    String    @unique
  installType           String    @default("installer") @map("install_type")
  installDate           String    @map("install_date")
  userPhone             String    @map("user_phone")
  installerPhone        String?   @map("installer_phone")
  consentPrivacy        Boolean   @map("consent_privacy")
  consentMarketing      Boolean   @default(false) @map("consent_marketing")
  status                String    @default("submitted")
  confirmToken          String?   @unique @map("confirm_token")
  confirmTokenExpiresAt DateTime? @map("confirm_token_expires_at")
  freeAsEndDate         String?   @map("free_as_end_date")
  submittedAt           DateTime  @default(now()) @map("submitted_at")
  confirmedAt           DateTime? @map("confirmed_at")
  confirmedBy           String?   @map("confirmed_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  surveySentAt          DateTime? @map("survey_sent_at")
  survey                SatisfactionSurvey?

  @@index([status])
  @@map("warranty_registrations")
}

model Installer {
  id                   String   @id @default(uuid())
  name                 String
  phone                String   @unique
  branch               String?
  region               String?
  coverage             String?
  address              String?
  category             String?
  ability              String?
  installCount         Int?     @map("install_count")
  happyCallLt          Int?     @map("happy_call_lt")
  defectCount          Int?     @map("defect_count")
  dissatisfactionNote  String?  @db.Text @map("dissatisfaction_note")
  serviceAreas         String[] @default([]) @map("service_areas")
  capabilities         String[] @default([]) @map("capabilities")
  aqaraAppCapability   String   @default("NONE") @map("aqara_app_capability")
  hasAqaraHubInventory Boolean  @default(false) @map("has_aqara_hub_inventory")
  monthlyDispatchCount Int      @default(0) @map("monthly_dispatch_count")
  active               Boolean  @default(true) @map("active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([branch])
  @@index([region])
  @@map("installers")
}

model Admin {
  id        String   @id @default(uuid())
  loginCode String   @unique @map("login_code")
  name      String
  level     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([level])
  @@map("admins")
}

model SmsTemplate {
  key       String   @id
  body      String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("sms_templates")
}

model SatisfactionSurvey {
  id              String               @id @default(uuid())
  registrationId  String               @unique @map("registration_id")
  registration    WarrantyRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  q1_1            String               // 기사 방문 시간 (예/아니오/잘 모르겠어요)
  q1_2            String               // 설치 품질 (예/아니오/잘 모르겠어요)
  q1_3            String               // 제품 사용 설명 (예/아니오/잘 모르겠어요)
  q2_1            String               // 앱 설치 편리성 (예/아니오/잘 모르겠어요)
  q2_2            String               // 회원가입 및 기기등록 (예/아니오/잘 모르겠어요)
  q2_3            String               // 앱 사용 만족도 (예/아니오/잘 모르겠어요)
  q3_1            Int                  // 도어락 사용 만족도 (1점 ~ 5점)
  comment         String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at")

  @@map("satisfaction_surveys")
}

