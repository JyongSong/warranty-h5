{
  "enabled": {
    "key": "installation.dispatcher.enabled",
    "description": "설치 dispatcher cron 실행 여부"
  },
  "lockTtlMs": {
    "key": "installation.dispatcher.lockTtlMs",
    "description": "설치 dispatcher 실행 lock 유지 시간(ms)",
    "default": 240000,
    "min": 60000,
    "max": 240000
  },
  "customerInputRequestMode": {
    "key": "installation.sms.customerInputRequestMode",
    "description": "고객 입력 요청 문자 발송 방식(auto/manual)",
    "default": "manual"
  },
  "limits": {
    "processInstallationOrders": {
      "key": "installation.dispatcher.limit.processInstallationOrders",
      "description": "신규 설치 주문 최대 처리 건수",
      "default": 25,
      "min": 1,
      "max": 100
    },
    "remindCustomerRequests": {
      "key": "installation.dispatcher.limit.remindCustomerRequests",
      "description": "고객 입력 리마인드 생성 최대 처리 건수",
      "default": 25,
      "min": 1,
      "max": 100
    },
    "fallbackCustomerRequests": {
      "key": "installation.dispatcher.limit.fallbackCustomerRequests",
      "description": "고객 미입력 폴백 최대 처리 건수",
      "default": 25,
      "min": 1,
      "max": 100
    },
    "dispatchReadyOrders": {
      "key": "installation.dispatcher.limit.dispatchReadyOrders",
      "description": "기사 후보 선정/배정 요청 생성 최대 처리 건수",
      "default": 10,
      "min": 1,
      "max": 100
    },
    "timeoutInstallerAssignments": {
      "key": "installation.dispatcher.limit.timeoutInstallerAssignments",
      "description": "기사 응답 timeout 최대 처리 건수",
      "default": 25,
      "min": 1,
      "max": 100
    },
    "alertDueSoonOrders": {
      "key": "installation.dispatcher.limit.alertDueSoonOrders",
      "description": "설치 일정 임박 이슈 생성 최대 처리 건수",
      "default": 50,
      "min": 1,
      "max": 100
    },
    "sendInstallationNotifications": {
      "key": "installation.dispatcher.limit.sendInstallationNotifications",
      "description": "pending 설치 SMS 발송 최대 처리 건수",
      "default": 10,
      "min": 1,
      "max": 50
    },
    "syncSmsDeliveryReports": {
      "key": "installation.dispatcher.limit.syncSmsDeliveryReports",
      "description": "Solapi SMS 배송 상태 조회 최대 처리 건수",
      "default": 25,
      "min": 1,
      "max": 100
    }
  }
}
